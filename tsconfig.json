{
  "compilerOptions": {
    "module": "Node16",
    "target": "es6",
    "resolveJsonModule": true,      
    "lib": ["es6", "dom"],
    "types": ["cypress", "node"],
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "cypress/**/*.ts",
    "cypress.config.ts"
  ]
}
